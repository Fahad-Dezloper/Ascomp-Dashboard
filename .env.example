# Database (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Redis (BullMQ / export worker) — use redis:// or rediss:// for TLS
REDIS_URL=redis://localhost:6379

# Better Auth — generate a long random string for production
BETTER_AUTH_SECRET=
# Base URL of this app (no trailing slash). Must match the origin you open in the browser.
BETTER_AUTH_URL=http://localhost:3000
# Exposed to the browser for SSR; keep in sync with BETTER_AUTH_URL in dev
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# CORS / trusted origins for Better Auth (single origin, no trailing slash)
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_CORS_ORIGIN=http://localhost:3000

# Absolute links in emails (e.g. workflow links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Blob (uploads)
BLOB_READ_WRITE_TOKEN=

# Email — simple SMTP (see src/lib/email.ts)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Email — OAuth (Gmail API, some admin routes)
GMAIL_OAUTH_USER=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# Optional: Upstash KV (if used)
KV_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Optional: Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
